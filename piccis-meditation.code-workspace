{
	"folders": [
		{
			"name": "root",
			"path": "."
		},
		{
			"name": "backend",
			"path": "backend"
		},
		{
			"name": "frontend",
			"path": "frontend"
		}
	],
	"settings": {},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "fe_dev",
				"type": "shell",
				"command": "npm",
				"args": [
					"run",
					"dev"
				],
				"options": {
					"cwd": "${workspaceFolder:frontend}"
				},
				"group": {
					"kind": "build",
					"isDefault": false
				},
				"problemMatcher": []
			},
			{
				"label": "be_dev",
				"type": "shell",
				"command": "go",
				"args": [
					"run",
					"./cmd/api"
				],
				"options": {
					"cwd": "${workspaceFolder:backend}",
					"env": {
						"APP_ENV": "development",
						"HTTP_ADDR": ":7004"
					}
				},
				"problemMatcher": []
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "backend",
				"type": "go",
				"request": "launch",
				"mode": "auto",
				"program": "${workspaceFolder:backend}/cmd/api",
				"cwd": "${workspaceFolder:backend}",
				"env": {
					"HTTP_ADDR": ":7004",
					"APP_ENV": "development"
				},
				"args": []
			}
		],
		"compounds": []
	},
	"extensions": {
		"recommendations": [
			"golang.go",
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode"
		]
	}
}